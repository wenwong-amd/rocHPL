#!/bin/bash
# Author: Michael Lough
# Modified by: Noel Chalmers

CXX_PATH=`which g++`
MYPRGENV_FLAVOR=${PE_ENV}
case ${MYPRGENV_FLAVOR} in
    "CRAY")
        MYMPICH_COMPILER_VERSION=${PE_MPICH_GENCOMPILERS_CRAY}
        ;;
    "AMD")
        MYMPICH_COMPILER_VERSION=${PE_MPICH_GENCOMPILERS_AMD}
        ;;
    "GNU")
        MYMPICH_COMPILER_VERSION=${PE_MPICH_GENCOMPILERS_GNU}
        ;;
    "AOCC")
        MYMPICH_COMPILER_VERSION=${PE_MPICH_GENCOMPILERS_AOCC}
        ;;
    *)
        MYMPICH_COMPILER_VERSION=${MYPRGENV_FLAVOR}"_is_not_recognized"
        ;;
esac
MPICH_DIR=${CRAY_MPICH_BASEDIR}/${PE_ENV}/${MYMPICH_COMPILER_VERSION}
CFLAGS="-I${MPICH_DIR}/include"
LDFLAGS="-L${MPICH_DIR}/lib -lmpi ${PE_MPICH_GTL_DIR_amd_gfx90a} -lmpi_gtl_hsa -L${ROCM_PATH}/lib -lhsa-runtime64"
if [[ $* == *-show* ]]
then
    echo ${CXX_PATH} ${CFLAGS} ${LDFLAGS}
else
    echo "Do not actually compile with these wrappers.\n Use pkg-config to add your own flags instead"
    exec $(${CXX_PATH} ${CFLAGS} $* ${LDFLAGS})
fi

